# Copie ce fichier en .env.local pour le développement, et renseigne les mêmes
# variables dans Railway (onglet Variables du service).

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Upstash Redis (optionnel en local). Les noms KV_REST_API_URL / KV_REST_API_TOKEN
# (ancienne intégration Vercel) sont aussi acceptés.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optionnel : URL publique du site, utilisée dans les liens de confirmation d'e-mail.
# NEXT_PUBLIC_SITE_URL=https://beffroi.up.railway.app
