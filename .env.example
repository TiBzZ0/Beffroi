# Copie ce fichier en .env.local pour le développement, et renseigne les mêmes
# variables dans le .env de la pile Docker du PC-serveur (voir README, « Mise en ligne »).

# Supabase (cloud : Project Settings → API Keys ; auto-hébergé : clés générées localement)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Redis à l'API Upstash (optionnel en local ; sur le PC-serveur : serverless-redis-http).
# Les noms KV_REST_API_URL / KV_REST_API_TOKEN sont aussi acceptés.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optionnel : URL publique du site, utilisée dans les liens de confirmation d'e-mail.
# NEXT_PUBLIC_SITE_URL=https://machine-serveur.tail6d5d9d.ts.net

# Optionnel : « Mot de passe oublié » par e-mail, seulement si Supabase a un SMTP configuré.
# NEXT_PUBLIC_PASSWORD_RESET=1
